{
    "name": "worldaffairs",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev:sveltekit": "pnpm --filter sveltekit dev",
        "dev:sanity": "pnpm --filter sanity start",
        "dev": "mprocs",
        "deploy:sanity": "pnpm --filter sanity deploy",
        "typegen:sanity": "pnpm --filter sanity exec sanity schema extract --enforce-required-fields && pnpm --filter sanity exec sanity typegen generate",
        "check": "pnpm --filter sveltekit check",
        "format": "prettier --write ."
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "mprocs": "^0.8.2",
        "prettier": "^3.8.0",
        "prettier-plugin-svelte": "^3.4.1",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.18.1"
}
